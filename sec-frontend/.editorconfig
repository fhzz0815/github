# EditorConfig 统一编辑器配置
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,ts,vue,json,html,css,scss}]
indent_size = 2

[*.{java,xml,yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
