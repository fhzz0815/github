<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.DishTasteMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.DishTasteEntity">
        <id column="id" property="id"/>

        <result column="store_id" property="storeId"/>
        <result column="taste_name" property="tasteName"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, store_id, taste_name, sort, status, create_time, is_deleted
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `dish_taste`
        <where>
            is_deleted = 0
            <if test="query != null">
                <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
                <if test="query.tasteName != null">AND taste_name = #{query.tasteName}</if>
                <if test="query.sort != null">AND sort = #{query.sort}</if>
                <if test="query.status != null">AND status = #{query.status}</if>
                <if test="query.createTime != null">AND create_time = #{query.createTime}</if>
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `dish_taste`
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.DishTasteEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `dish_taste`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeId != null">store_id,</if>
            <if test="tasteName != null">taste_name,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="storeId != null">#{storeId},</if>
            <if test="tasteName != null">#{tasteName},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.DishTasteEntity">
        UPDATE `dish_taste`
        <set>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="tasteName != null">taste_name = #{tasteName},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE `dish_taste` SET is_deleted = 1 WHERE id = #{id}
    </update>

</mapper>
