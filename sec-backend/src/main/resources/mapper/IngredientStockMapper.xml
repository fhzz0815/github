<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.IngredientStockMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.IngredientStockEntity">
        <id column="id" property="id"/>

        <result column="store_id" property="storeId"/>
        <result column="ingredient_id" property="ingredientId"/>
        <result column="stock_quantity" property="stockQuantity"/>
        <result column="warn_threshold" property="warnThreshold"/>
        <result column="unit" property="unit"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, store_id, ingredient_id, stock_quantity, warn_threshold, unit, create_time, update_time
    </sql>

                <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `ingredient_stock`
        <where>
            <if test="query.unit != null and query.unit != ''">AND unit LIKE CONCAT('%', #{query.unit}, '%')</if>
            <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
            <if test="query.ingredientId != null">AND ingredient_id = #{query.ingredientId}</if>
            <if test="query.searchBeginTime != null and query.searchBeginTime != ''">AND create_time &gt;= CONCAT(#{query.searchBeginTime}, ' 00:00:00')</if>
            <if test="query.searchEndTime != null and query.searchEndTime != ''">AND create_time &lt;= CONCAT(#{query.searchEndTime}, ' 23:59:59')</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `ingredient_stock`
        WHERE id = #{id}
    </select>

    <select id="selectByStoreAndIngredient" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `ingredient_stock`
        WHERE store_id = #{storeId} AND ingredient_id = #{ingredientId}
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.IngredientStockEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `ingredient_stock`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeId != null">store_id,</if>
            <if test="ingredientId != null">ingredient_id,</if>
            <if test="stockQuantity != null">stock_quantity,</if>
            <if test="warnThreshold != null">warn_threshold,</if>
            <if test="unit != null">unit,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="storeId != null">#{storeId},</if>
            <if test="ingredientId != null">#{ingredientId},</if>
            <if test="stockQuantity != null">#{stockQuantity},</if>
            <if test="warnThreshold != null">#{warnThreshold},</if>
            <if test="unit != null">#{unit},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.IngredientStockEntity">
        UPDATE `ingredient_stock`
        <set>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="ingredientId != null">ingredient_id = #{ingredientId},</if>
            <if test="stockQuantity != null">stock_quantity = #{stockQuantity},</if>
            <if test="warnThreshold != null">warn_threshold = #{warnThreshold},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `ingredient_stock` WHERE id = #{id}
    </delete>

</mapper>
