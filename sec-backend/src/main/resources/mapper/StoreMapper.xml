    <update id="update" parameterType="com.iwe3.sec.entity.StoreEntity">
        UPDATE `store`
        <set>
            <if test="storeNo != null">store_no = #{storeNo},</if>
            <if test="storeName != null">store_name = #{storeName},</if>
            <if test="province != null">province = #{province},</if>
