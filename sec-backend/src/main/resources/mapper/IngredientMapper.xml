<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.IngredientMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.IngredientEntity">
        <id column="id" property="id"/>

        <result column="store_id" property="storeId"/>
        <result column="category_id" property="categoryId"/>
        <result column="ingredient_name" property="ingredientName"/>
        <result column="unit" property="unit"/>
        <result column="spec" property="spec"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, store_id, category_id, ingredient_name, unit, spec, status, create_time, is_deleted
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `ingredient`
        <where>
            is_deleted = 0
            <if test="query != null">
                <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
                <if test="query.categoryId != null">AND category_id = #{query.categoryId}</if>
                <if test="query.ingredientName != null">AND ingredient_name = #{query.ingredientName}</if>
                <if test="query.unit != null">AND unit = #{query.unit}</if>
                <if test="query.spec != null">AND spec = #{query.spec}</if>
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `ingredient`
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.IngredientEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `ingredient`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeId != null">store_id,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="ingredientName != null">ingredient_name,</if>
            <if test="unit != null">unit,</if>
            <if test="spec != null">spec,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="storeId != null">#{storeId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="ingredientName != null">#{ingredientName},</if>
            <if test="unit != null">#{unit},</if>
            <if test="spec != null">#{spec},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.IngredientEntity">
        UPDATE `ingredient`
        <set>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="ingredientName != null">ingredient_name = #{ingredientName},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE `ingredient` SET is_deleted = 1 WHERE id = #{id}
    </update>

</mapper>
