"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.RedPacketMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.RedPacketEntity">
        <id column="id" property="id"/>

        <result column="red_packet_no" property="redPacketNo"/>
        <result column="member_id" property="memberId"/>
        <result column="store_id" property="storeId"/>
        <result column="amount" property="amount"/>
        <result column="source" property="source"/>
        <result column="status" property="status"/>
        <result column="expire_time" property="expireTime"/>
        <result column="use_time" property="useTime"/>
        <result column="order_id" property="orderId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, red_packet_no, member_id, store_id, amount, source, status, expire_time, use_time, order_id, create_time
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `red_packet`
        <where>
            <if test="query != null">
                <if test="query.redPacketNo != null">AND red_packet_no = #{query.redPacketNo}</if>
                <if test="query.memberId != null">AND member_id = #{query.memberId}</if>
                <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
                <if test="query.amount != null">AND amount = #{query.amount}</if>
                <if test="query.source != null">AND source = #{query.source}</if>
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `red_packet`
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.RedPacketEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `red_packet`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="redPacketNo != null">red_packet_no,</if>
            <if test="memberId != null">member_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="amount != null">amount,</if>
            <if test="source != null">source,</if>
            <if test="status != null">status,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="useTime != null">use_time,</if>
            <if test="orderId != null">order_id,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="redPacketNo != null">#{redPacketNo},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="source != null">#{source},</if>
            <if test="status != null">#{status},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="useTime != null">#{useTime},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.RedPacketEntity">
        UPDATE `red_packet`
        <set>
            <if test="redPacketNo != null">red_packet_no = #{redPacketNo},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="source != null">source = #{source},</if>
            <if test="status != null">status = #{status},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="useTime != null">use_time = #{useTime},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `red_packet` WHERE id = #{id}
    </delete>

</mapper>
