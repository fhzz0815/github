<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.TableTypeMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.TableTypeEntity">
        <id column="id" property="id"/>

        <result column="store_id" property="storeId"/>
        <result column="type_name" property="typeName"/>
        <result column="max_persons" property="maxPersons"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, store_id, type_name, max_persons, sort, status, create_time, is_deleted
    </sql>

                <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `table_type`
        <where>
            is_deleted = 0
            <if test="query.searchKeyword != null and query.searchKeyword != ''">
                AND (
type_name LIKE CONCAT('%', #{query.searchKeyword}, '%')
                )
            </if>
            <if test="query.typeName != null and query.typeName != ''">AND type_name LIKE CONCAT('%', #{query.typeName}, '%')</if>
            <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
            <if test="query.maxPersons != null">AND max_persons = #{query.maxPersons}</if>
            <if test="query.sort != null">AND sort = #{query.sort}</if>
            <if test="query.status != null">AND status = #{query.status}</if>
            <if test="query.searchBeginTime != null and query.searchBeginTime != ''">AND create_time &gt;= CONCAT(#{query.searchBeginTime}, ' 00:00:00')</if>
            <if test="query.searchEndTime != null and query.searchEndTime != ''">AND create_time &lt;= CONCAT(#{query.searchEndTime}, ' 23:59:59')</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `table_type`
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.TableTypeEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `table_type`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeId != null">store_id,</if>
            <if test="typeName != null">type_name,</if>
            <if test="maxPersons != null">max_persons,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="storeId != null">#{storeId},</if>
            <if test="typeName != null">#{typeName},</if>
            <if test="maxPersons != null">#{maxPersons},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.TableTypeEntity">
        UPDATE `table_type`
        <set>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="typeName != null">type_name = #{typeName},</if>
            <if test="maxPersons != null">max_persons = #{maxPersons},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE `table_type` SET is_deleted = 1 WHERE id = #{id}
    </update>

</mapper>
