<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.DishIngredientRelMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.DishIngredientRelEntity">
        <id column="id" property="id"/>

        <result column="dish_id" property="dishId"/>
        <result column="ingredient_id" property="ingredientId"/>
        <result column="quantity" property="quantity"/>
        <result column="unit" property="unit"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, dish_id, ingredient_id, quantity, unit, create_time
    </sql>

                <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `dish_ingredient_rel`
        <where>
            <if test="query.unit != null and query.unit != ''">AND unit LIKE CONCAT('%', #{query.unit}, '%')</if>
            <if test="query.dishId != null">AND dish_id = #{query.dishId}</if>
            <if test="query.ingredientId != null">AND ingredient_id = #{query.ingredientId}</if>
            <if test="query.searchBeginTime != null and query.searchBeginTime != ''">AND create_time &gt;= CONCAT(#{query.searchBeginTime}, ' 00:00:00')</if>
            <if test="query.searchEndTime != null and query.searchEndTime != ''">AND create_time &lt;= CONCAT(#{query.searchEndTime}, ' 23:59:59')</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `dish_ingredient_rel`
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.DishIngredientRelEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `dish_ingredient_rel`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dishId != null">dish_id,</if>
            <if test="ingredientId != null">ingredient_id,</if>
            <if test="quantity != null">quantity,</if>
            <if test="unit != null">unit,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="dishId != null">#{dishId},</if>
            <if test="ingredientId != null">#{ingredientId},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="unit != null">#{unit},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.DishIngredientRelEntity">
        UPDATE `dish_ingredient_rel`
        <set>
            <if test="dishId != null">dish_id = #{dishId},</if>
            <if test="ingredientId != null">ingredient_id = #{ingredientId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `dish_ingredient_rel` WHERE id = #{id}
    </delete>

</mapper>
