<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.MemberCouponMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.MemberCouponEntity">
        <id column="id" property="id"/>

        <result column="member_id" property="memberId"/>
        <result column="coupon_id" property="couponId"/>
        <result column="store_id" property="storeId"/>
        <result column="status" property="status"/>
        <result column="receive_time" property="receiveTime"/>
        <result column="expire_time" property="expireTime"/>
        <result column="use_time" property="useTime"/>
        <result column="order_id" property="orderId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, member_id, coupon_id, store_id, status, receive_time, expire_time, use_time, order_id, create_time
    </sql>

                <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `member_coupon`
        <where>
            <if test="query.memberId != null">AND member_id = #{query.memberId}</if>
            <if test="query.couponId != null">AND coupon_id = #{query.couponId}</if>
            <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
            <if test="query.status != null">AND status = #{query.status}</if>
            <if test="query.orderId != null">AND order_id = #{query.orderId}</if>
            <if test="query.searchBeginTime != null and query.searchBeginTime != ''">AND create_time &gt;= CONCAT(#{query.searchBeginTime}, ' 00:00:00')</if>
            <if test="query.searchEndTime != null and query.searchEndTime != ''">AND create_time &lt;= CONCAT(#{query.searchEndTime}, ' 23:59:59')</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `member_coupon`
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.MemberCouponEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `member_coupon`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="couponId != null">coupon_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="status != null">status,</if>
            <if test="receiveTime != null">receive_time,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="useTime != null">use_time,</if>
            <if test="orderId != null">order_id,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="couponId != null">#{couponId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="status != null">#{status},</if>
            <if test="receiveTime != null">#{receiveTime},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="useTime != null">#{useTime},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.MemberCouponEntity">
        UPDATE `member_coupon`
        <set>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="couponId != null">coupon_id = #{couponId},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="receiveTime != null">receive_time = #{receiveTime},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="useTime != null">use_time = #{useTime},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `member_coupon` WHERE id = #{id}
    </delete>

    <!-- 释放优惠券（取消订单时将已使用的优惠券状态回退为未使用） -->
    <update id="releaseCoupon">
        UPDATE `member_coupon`
        SET status = 1, use_time = NULL, order_id = NULL
        WHERE id = #{id} AND order_id = #{orderId} AND status = 2
    </update>

    <!-- 按订单号释放优惠券（当不确定 member_coupon.id 时使用） -->
    <update id="releaseCouponByOrder">
        UPDATE `member_coupon`
        SET status = 1, use_time = NULL, order_id = NULL
        WHERE order_id = #{orderId} AND status = 2
    </update>

</mapper>
