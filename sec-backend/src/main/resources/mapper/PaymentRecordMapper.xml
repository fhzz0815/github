<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwe3.sec.mapper.PaymentRecordMapper">

    <resultMap id="BaseResultMap" type="com.iwe3.sec.entity.PaymentRecordEntity">
        <id column="id" property="id"/>

        <result column="pay_no" property="payNo"/>
        <result column="order_id" property="orderId"/>
        <result column="store_id" property="storeId"/>
        <result column="member_id" property="memberId"/>
        <result column="pay_type" property="payType"/>
        <result column="pay_channel" property="payChannel"/>
        <result column="amount" property="amount"/>
        <result column="status" property="status"/>
        <result column="transaction_id" property="transactionId"/>
        <result column="idempotency_key" property="idempotencyKey"/>
        <result column="payer_account" property="payerAccount"/>
        <result column="notify_time" property="notifyTime"/>
        <result column="pay_time" property="payTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, pay_no, order_id, store_id, member_id, pay_type, pay_channel, amount, status, transaction_id, idempotency_key, payer_account, notify_time, pay_time, create_time
    </sql>

                <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `payment_record`
        <where>
            <if test="query.searchKeyword != null and query.searchKeyword != ''">
                AND (
pay_no LIKE CONCAT('%', #{query.searchKeyword}, '%')
                )
            </if>
            <if test="query.payNo != null and query.payNo != ''">AND pay_no LIKE CONCAT('%', #{query.payNo}, '%')</if>
            <if test="query.payType != null and query.payType != ''">AND pay_type LIKE CONCAT('%', #{query.payType}, '%')</if>
            <if test="query.payChannel != null and query.payChannel != ''">AND pay_channel LIKE CONCAT('%', #{query.payChannel}, '%')</if>
            <if test="query.transactionId != null and query.transactionId != ''">AND transaction_id LIKE CONCAT('%', #{query.transactionId}, '%')</if>
            <if test="query.idempotencyKey != null and query.idempotencyKey != ''">AND idempotency_key LIKE CONCAT('%', #{query.idempotencyKey}, '%')</if>
            <if test="query.payerAccount != null and query.payerAccount != ''">AND payer_account LIKE CONCAT('%', #{query.payerAccount}, '%')</if>
            <if test="query.orderId != null">AND order_id = #{query.orderId}</if>
            <if test="query.storeId != null">AND store_id = #{query.storeId}</if>
            <if test="query.memberId != null">AND member_id = #{query.memberId}</if>
            <if test="query.status != null">AND status = #{query.status}</if>
            <if test="query.searchBeginTime != null and query.searchBeginTime != ''">AND create_time &gt;= CONCAT(#{query.searchBeginTime}, ' 00:00:00')</if>
            <if test="query.searchEndTime != null and query.searchEndTime != ''">AND create_time &lt;= CONCAT(#{query.searchEndTime}, ' 23:59:59')</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `payment_record`
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.iwe3.sec.entity.PaymentRecordEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `payment_record`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="payNo != null">pay_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="payType != null">pay_type,</if>
            <if test="payChannel != null">pay_channel,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null">status,</if>
            <if test="transactionId != null">transaction_id,</if>
            <if test="idempotencyKey != null">idempotency_key,</if>
            <if test="payerAccount != null">payer_account,</if>
            <if test="notifyTime != null">notify_time,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="payNo != null">#{payNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="payType != null">#{payType},</if>
            <if test="payChannel != null">#{payChannel},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null">#{status},</if>
            <if test="transactionId != null">#{transactionId},</if>
            <if test="idempotencyKey != null">#{idempotencyKey},</if>
            <if test="payerAccount != null">#{payerAccount},</if>
            <if test="notifyTime != null">#{notifyTime},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.iwe3.sec.entity.PaymentRecordEntity">
        UPDATE `payment_record`
        <set>
            <if test="payNo != null">pay_no = #{payNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="payType != null">pay_type = #{payType},</if>
            <if test="payChannel != null">pay_channel = #{payChannel},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="transactionId != null">transaction_id = #{transactionId},</if>
            <if test="idempotencyKey != null">idempotency_key = #{idempotencyKey},</if>
            <if test="payerAccount != null">payer_account = #{payerAccount},</if>
            <if test="notifyTime != null">notify_time = #{notifyTime},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `payment_record` WHERE id = #{id}
    </delete>

</mapper>
