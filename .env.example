# ============================================================
# 智慧社区AI系统 - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================================================

# === 应用配置 ===
APP_NAME=smart-community
APP_VERSION=0.1.0
APP_ENV=dev
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# === 数据库 (MySQL 8) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=smart_community
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SLAVE_HOST=localhost
DB_SLAVE_PORT=3307

# === 缓存 (Redis 7) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_NODES=sentinel1:26379,sentinel2:26380,sentinel3:26381

# === 消息队列 (RabbitMQ) ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# === LLM 模型配置 ===
LLM_PROVIDER=openai  # openai / azure / local
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=rerank-v2

# === 向量库 ===
VECTOR_STORE_TYPE=pgvector  # pgvector / milvus / chroma
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=5432

# === JWT 鉴权 ===
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=7200
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=1209600

# === 日志 ===
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === 对象存储 ===
OSS_TYPE=local  # local / s3 / oss
OSS_BUCKET=smart-community
OSS_ENDPOINT=http://localhost:9000
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin

# === AI 配额与成本控制 ===
AI_TOKEN_LIMIT_PER_DAY=1000000
AI_COST_ALERT_THRESHOLD=100.0
AI_RATE_LIMIT_PER_MINUTE=30
